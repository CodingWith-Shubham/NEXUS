# JARVIS laptop agent. Copy to laptop_agent/.env (git-ignored).

# Supabase project URL and the anon / publishable key (Project Settings > API).
# NOT the service_role key: the agent can only call the three laptop_* functions.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Same value as LAPTOP_AGENT_SECRET in server/.env. Verifies every command's signature.
LAPTOP_AGENT_SECRET=

# The agent's database token (laptop only). Only its SHA-256 goes into Supabase:
#   uv run python -m laptop_agent hash-token
LAPTOP_AGENT_DB_TOKEN=
