# JARVIS - Environment Variables
# Copy this file to .env and fill in your API keys

# Google Gemini Live (speech-to-speech: hearing, thinking and speaking)
GOOGLE_API_KEY=
# Must be a Live model; leave unset to use the default (models/gemini-3.8-live)
GOOGLE_MODEL=models/gemini-3.8-live
# Gemini voice, e.g. Charon, Puck, Kore, Fenrir, Aoede
GOOGLE_VOICE_ID=Charon

# Supabase (Project Settings > API). service_role bypasses row level security:
# keep it server-side only, never in a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Background worker models ([worker] models in jarvis.toml): Nemotron via OpenRouter.
# An OpenRouter key (sk-or-...). https://openrouter.ai/keys
NEMOTRON_KEY=

# Tavily web search ([search] provider = "tavily" in jarvis.toml). https://app.tavily.com
TAVILY_API_KEY=

# Google OAuth client (Web application) for calendar + Gmail ([workspace] in jarvis.toml).
# Authorized redirect URI: http://localhost:7860/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encrypts stored OAuth tokens. Generate with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JARVIS_TOKEN_KEY=
