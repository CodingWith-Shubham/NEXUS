# JARVIS - Environment Variables
# Copy this file to .env and fill in your API keys

# Google Gemini Live (speech-to-speech: hearing, thinking and speaking)
GOOGLE_API_KEY=
# Must be a Live model; leave unset to use the default (models/gemini-3.8-live)
GOOGLE_MODEL=models/gemini-3.8-live
# Gemini voice, e.g. Charon, Puck, Kore, Fenrir, Aoede
GOOGLE_VOICE_ID=Charon

# Supabase (Project Settings > API). service_role bypasses row level security:
# keep it server-side only, never in a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Background worker models ([worker] models in jarvis.toml): Nemotron via OpenRouter.
# An OpenRouter key (sk-or-...). https://openrouter.ai/keys
NEMOTRON_KEY=

# Tavily web search ([search] provider = "tavily" in jarvis.toml). https://app.tavily.com
TAVILY_API_KEY=

# Google OAuth client (Web application). Used for two separate flows:
#   - signing in to JARVIS (openid, email, profile), and
#   - each user connecting Gmail + Calendar from Settings ([workspace] in jarvis.toml).
# Authorized redirect URIs on the client (both):
#   http://localhost:7860/auth/login/callback
#   http://localhost:7860/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Invite list: the Google addresses that may sign in (comma separated). Anyone else
# is refused. Removing an address ends that person's sessions on their next request.
ALLOWED_EMAILS=

# Signs the session cookie and the Gmail/Calendar connect state. Changing it signs
# everyone out. Generate with:
# uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JARVIS_SESSION_SECRET=

# Dev only: lets `pipecat eval` (which can't sign in) connect to ws://localhost:7860/ws,
# from this machine only, running as this JARVIS user. Leave empty otherwise.
JARVIS_EVAL_USER_EMAIL=

# Encrypts stored OAuth tokens. Generate with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JARVIS_TOKEN_KEY=

# SignalHire contact lookups (Phase 5, [contacts] in jarvis.toml). https://www.signalhire.com
SIGNALHIRE_API_KEY=

# LinkedIn app (Phase 6, [linkedin] in jarvis.toml): https://www.linkedin.com/developers/apps
# Products needed: "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn".
# Authorized redirect URL on the app's Auth tab: http://localhost:7860/auth/linkedin/callback
# (CLIENT_ID / PRIMARY_CLIENT_SECRET are also accepted.)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Laptop agent (skills/laptop). Signs every laptop command (HMAC-SHA256); the same value goes in
# laptop_agent/.env. 32+ random characters, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LAPTOP_AGENT_SECRET=
