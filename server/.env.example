# JARVIS - Environment Variables
# Copy this file to .env and fill in your API keys

# Google Gemini Live (speech-to-speech: hearing, thinking and speaking)
GOOGLE_API_KEY=
# Must be a Live model; leave unset to use the default (models/gemini-3.8-live)
GOOGLE_MODEL=models/gemini-3.8-live
# Gemini voice, e.g. Charon, Puck, Kore, Fenrir, Aoede
GOOGLE_VOICE_ID=Charon
